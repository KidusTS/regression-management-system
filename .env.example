Frontend (frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8080/api

Backend (environment variables)
# `./gradlew bootRun` activates the `dev` profile, which has local defaults for everything below.
# Production (no profile) REQUIRES DB_URL, DB_USERNAME, DB_PASSWORD and JWT_SECRET, or it refuses to start.
DB_URL=jdbc:postgresql://localhost:5433/regression_db
DB_USERNAME=postgres
DB_PASSWORD=change-me
# >= 32 bytes. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated browser origins allowed to call the API
ALLOWED_ORIGIN=http://localhost:3000
# Optional: the account registering with this email becomes ADMIN
ADMIN_EMAIL=
